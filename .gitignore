# ---------------------------------------------------------------------------
# Unreal Engine: everything below is rebuilt by the editor on first open
# ---------------------------------------------------------------------------
Binaries/
Intermediate/
DerivedDataCache/
Build/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Saved/ holds logs, autosaves, editor prefs AND all generated datasets
# (SegDataset_*, SegCapture, SDG/raw, SDG/datasets, roboflow zips). Back those
# up separately - they are tens of GB and are regenerated by the SDG pipeline.
Saved/

# IDE / solution files (regenerate via right-click .uproject > Generate project files)
.vs/
.vscode/
.idea/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Per-user editor content
Content/Developers/

# ---------------------------------------------------------------------------
# Datasets (in case one is written outside Saved/)
# ---------------------------------------------------------------------------
SegPipeline/**/datasets/
SegPipeline/**/raw/
*_roboflow.zip
*_yolo_seg.zip

# ---------------------------------------------------------------------------
# Model weights: ignore trained ones, keep the stock Ultralytics pretrained
# weights (yolo11s-seg.pt, yolo26n.pt, ...) so a fresh clone runs as-is.
# ---------------------------------------------------------------------------
runs/
*.pt
*.pth
*.onnx
*.engine
*.torchscript
!yolo*[0-9][nsmlx].pt
!yolo*[0-9][nsmlx]-seg.pt
!yolo*[0-9][nsmlx]-pose.pt
!yolo*[0-9][nsmlx]-obb.pt
!yolo*[0-9][nsmlx]-cls.pt

# ---------------------------------------------------------------------------
# SegPipeline runtime state
# ---------------------------------------------------------------------------
SegPipeline/sdg/.bridge/
SegPipeline/app/state/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Machine-specific local tooling config
.claude/

# OS junk
Thumbs.db
desktop.ini
.DS_Store
